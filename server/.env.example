# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Postgres (data store) - Supabase project.
# Supabase dashboard -> Project Settings -> Database -> Connection string.
# Use the "Transaction" pooler (port 6543, add ?pgbouncer=true) here, not
# the direct connection (port 5432) - serverless functions open a fresh
# connection per invocation and will exhaust Supabase's direct connection
# limit otherwise. Looks like:
# postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# Vercel Blob (file uploads: images/video/documents sent in messages).
# Storage tab -> Create Database -> Blob -> Connect to Project.
# Leave blank for local dev: uploads then fall back to server/uploads/
# on disk. Required in production (Vercel's filesystem is read-only).
BLOB_READ_WRITE_TOKEN=

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=12h

# Seed admin (used only by `npm run seed`)
SEED_ADMIN_NAME=School Admin
SEED_ADMIN_EMAIL=admin@school.test
SEED_ADMIN_PASSWORD=ChangeMe123!

# --- WhatsApp Business Platform (Cloud API) ---
# Leave blank for now. See server/src/services/whatsappService.js
# This build runs fully in "mock" mode without these.
WHATSAPP_API_BASE=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_MODE=mock
