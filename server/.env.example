# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Postgres (data store). Works with any Postgres provider (Neon, Supabase,
# RDS, local) via a standard connection string. On Vercel: Storage tab ->
# connect a Postgres database (e.g. Neon, via the Vercel Marketplace) to
# your project, then copy its connection string here (or run
# `vercel env pull server/.env` from the project root if it was injected
# under a different variable name, e.g. DATABASE_URL / POSTGRES_URL).
DATABASE_URL=

# Vercel Blob (file uploads: images/video/documents sent in messages).
# Storage tab -> Create Database -> Blob -> Connect to Project.
# Leave blank for local dev: uploads then fall back to server/uploads/
# on disk. Required in production (Vercel's filesystem is read-only).
BLOB_READ_WRITE_TOKEN=

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=12h

# Seed admin (used only by `npm run seed`)
SEED_ADMIN_NAME=School Admin
SEED_ADMIN_EMAIL=admin@school.test
SEED_ADMIN_PASSWORD=ChangeMe123!

# --- WhatsApp Business Platform (Cloud API) ---
# Leave blank for now. See server/src/services/whatsappService.js
# This build runs fully in "mock" mode without these.
WHATSAPP_API_BASE=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_MODE=mock
